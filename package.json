{
  "name": "example-a2ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter a2ui-chat-server --filter a2ui-chat-client dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test && cd copilotkit/gateway && go test ./...",
    "build": "pnpm --filter a2ui-chat-client --filter copilotkit-web build",
    "e2e": "node e2e/run.cjs",
    "dev:copilotkit": "pnpm --parallel --filter copilotkit-agent --filter copilotkit-web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "playwright": "1.63.0"
  }
}
